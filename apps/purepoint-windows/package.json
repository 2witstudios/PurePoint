{
  "name": "purepoint-windows",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PurePoint desktop app for Windows (Tauri 2 + React).",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "gen:protocol": "node scripts/gen-protocol.mjs",
    "e2e": "node ui/e2e/run.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
