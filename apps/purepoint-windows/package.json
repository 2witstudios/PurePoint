    "@wdio/globals": "~10.2.0",
    "@wdio/local-runner": "~10.2.0",
    "@wdio/mocha-framework": "~10.2.0",
    "@wdio/spec-reporter": "~10.2.0",
    "@wdio/types": "~10.2.0",
    "@xterm/headless": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
