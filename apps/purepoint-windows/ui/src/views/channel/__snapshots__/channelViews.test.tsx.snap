      </span>
    </div>
    <span
      class="channel-spacer"
    />
    <div
      class="channel-menu-anchor"
    >
      <button
        aria-expanded="false"
        aria-label="Channel members"
        class="channel-tool"
        title="Channel members"
        type="button"
      >
        <svg
          aria-hidden="true"
          class="lucide lucide-users"
          data-symbol="person.2"
