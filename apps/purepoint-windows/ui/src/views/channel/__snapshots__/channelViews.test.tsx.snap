            r="1"
          />
          <circle
            cx="19"
            cy="12"
            r="1"
          />
          <circle
            cx="5"
            cy="12"
            r="1"
          />
        </svg>
      </button>
    </div>
  </div>
  <div
    class="channel-unread-banner"
  >
    <button
      type="button"
    >
      1 unread messages ↓
    </button>
    <span
      class="channel-spacer"
    />
    <button
      aria-label="Mark as read"
      title="Mark as read"
      type="button"
    >
      <svg
        aria-hidden="true"
        class="lucide lucide-x"
