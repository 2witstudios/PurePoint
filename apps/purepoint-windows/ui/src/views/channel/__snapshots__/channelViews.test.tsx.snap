// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`in UTC > ProjectChannelView > renders channel-history.json like the Mac 1`] = `
<div
  class="channel-view"
  data-view="ProjectChannelView"
>
  <div
    class="channel-header"
  >
    <span
