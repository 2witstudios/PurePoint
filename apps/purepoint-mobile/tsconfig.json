{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "bridge/*.js",
    "support/pointguard/**/*.js"
  ],
  "exclude": [
    "bridge/*.test.js"
  ]
}
