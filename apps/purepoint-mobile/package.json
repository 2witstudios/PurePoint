    "qrcode": "1.5.4",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/ws": "8.18.1",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  }
}
